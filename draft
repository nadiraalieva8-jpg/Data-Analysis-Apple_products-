import os
import sqlite3
from datetime import datetime
import pandas as pd
import requests
from bs4 import BeautifulSoup

# Определение констант проекта
URL = "https://archive.org"
TABLE_ATTRIBS = ["Name", "MC_USD_Billion"]
CSV_PATH = "./Largest_banks_data.csv"
DB_PATH = "Banks.db"
TABLE_NAME = "Largest_banks"
LOG_FILE = "code_log.txt"
EXCHANGE_RATE_CSV = "exchange_rate.csv"


def log_progress(message):
    """Логирует текущую стадию выполнения процесса с отметкой времени."""
    timestamp_format = "%Y-%m-%d-%H:%M:%S"
    now = datetime.now()
    timestamp = now.strftime(timestamp_format)
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(f"{timestamp} : {message}\n")


def extract(url, table_attribs):
    """Скрапит веб-страницу и извлекает таблицу ТОП-10 крупнейших банков."""
    html_page = requests.get(url).text
    data = BeautifulSoup(html_page, "html.parser")

    # Создаем пустой датафрейм
    df = pd.DataFrame(columns=table_attribs)

    # Находим все таблицы на странице
    tables = data.find_all("table")
    # Первая таблица 'wikitable sortable' на этой архивной странице содержит нужные данные
    target_table = tables[0]

    rows = target_table.find_all("tr")

    count = 0
    for row in rows:
        col = row.find_all("td")
        if len(col) != 0:
            # Получаем название банка и убираем лишние символы переноса строки
            bank_name = col[1].find_all("a")[1].text.strip()
            # Получаем рыночную капитализацию в млрд USD
            market_cap = float(col[2].text.strip())

            # Добавляем в датафрейм
            df.loc[count] = [bank_name, market_cap]
            count += 1

    # Нам нужны только ТОП-10 крупнейших банков
    df = df.head(10)
    return df


def transform(df, csv_path):
    """Трансформирует данные, переводя USD в GBP, EUR и INR по курсу из файла."""
    # Читаем курсы валют из CSV
    exchange_df = pd.read_csv(csv_path)

    # Превращаем в словарь для быстрого поиска: {'EUR': 0.93, 'GBP': 0.8, 'INR': 82.5}
    exchange_dict = exchange_df.set_index("Currency")["Rate"].to_dict()

    # Добавляем новые колонки и рассчитываем значения с округлением до 2 знаков
    df["MC_GBP_Billion"] = [
        round(x * exchange_dict["GBP"], 2) for x in df["MC_USD_Billion"]
    ]
    df["MC_EUR_Billion"] = [
        round(x * exchange_dict["EUR"], 2) for x in df["MC_USD_Billion"]
    ]
    df["MC_INR_Billion"] = [
        round(x * exchange_dict["INR"], 2) for x in df["MC_USD_Billion"]
    ]

    return df


def load_to_csv(df, csv_path):
    """Сохраняет итоговый датафрейм в локальный файл CSV."""
    df.to_csv(csv_path, index=False)


def load_to_db(df, sql_connection, table_name):
    """Сохраняет датафрейм как таблицу в базу данных SQLite."""
    df.to_sql(table_name, sql_connection, if_exists="replace", index=False)


def run_query(query_statement, sql_connection):
    """Выполняет SQL-запросы к базе данных и выводит результат на экран."""
    print(f"Executing query: {query_statement}")
    query_output = pd.read_sql(query_statement, sql_connection)
    print(query_output)
    print("-" * 50)


# Основной оркестрационный процесс ETL конвейера
if __name__ == "__main__":
    # Проверяем наличие файла с курсами валют перед стартом
    if not os.path.exists(EXCHANGE_RATE_CSV):
        print(f"Ошибка: Файл '{EXCHANGE_RATE_CSV}' не найден в текущей папке!")
        print("Пожалуйста, создайте его или скачайте из материалов лабы.")
        exit(1)

    log_progress("Preliminaries complete. Initiating ETL process")

    # Шаг 1: Экстракция (Сбор данных)
    df_extracted = extract(URL, TABLE_ATTRIBS)
    log_progress("Data extraction complete. Initiating Transformation process")

    # Шаг 2: Трансформация
    df_transformed = transform(df_extracted, EXCHANGE_RATE_CSV)
    log_progress("Data transformation complete. Initiating Loading process")

    # Шаг 3: Загрузка в CSV файл
    load_to_csv(df_transformed, CSV_PATH)
    log_progress("Data saved to CSV file")

    # Шаг 4: Загрузка в базу данных SQLite
    sql_conn = sqlite3.connect(DB_PATH)
    log_progress("SQL Connection initiated")

    load_to_db(df_transformed, sql_conn, TABLE_NAME)
    log_progress("Data loaded to Database as a table")

    # Шаг 5: Выполнение обязательных проверочных SQL-запросов
    # Запрос 1: Вывести всю таблицу целиком
    query_1 = f"SELECT * FROM {TABLE_NAME}"
    run_query(query_1, sql_conn)

    # Запрос 2: Среднее значение капитализации в GBP
    query_2 = f"SELECT AVG(MC_GBP_Billion) FROM {TABLE_NAME}"
    run_query(query_2, sql_conn)

    # Запрос 3: Вывести топ-5 банков по версии EUR
    query_3 = f"SELECT Name from {TABLE_NAME} LIMIT 5"
    run_query(query_3, sql_conn)

    log_progress("Process Complete")

    # Закрываем соединение
    sql_conn.close()
    log_progress("Server Connection closed")

